# Copy to .env and adjust per target box. Never commit .env.
# ⚠️ Hosts are separate physical machines; always state which host a run used.
EHR_HOST=fbch34
EHR_USER=demo
EHR_PASS=123
WEBFRAME_DIR=webframe
# IANA timezone the box renders dates in (date assertions use it; default America/Los_Angeles).
#EHR_TZ=America/Los_Angeles
# Server ops over SSH: the ADDRESS follows EHR_HOST; the user writes the box OS
# account + password. Empty EHR_SSH_USER = SSH disabled (server-op steps fail with
# a diagnostic instead of running).
# One-time onboarding per box: fill EHR_SSH_USER + EHR_SSH_PASS, run `npm run
# setup:ssh` (idempotent). It installs a local key over a one-time password login
# and verifies passwordless BatchMode auth. Switching EHR_HOST to an already
# onboarded box needs NO re-setup; a new box needs it once. The runtime never
# uses the password — remove EHR_SSH_PASS afterwards. Requires the box to allow
# password login for the user.
#EHR_SSH_USER=guoyq
#EHR_SSH_PASS=
# Optional override when the target differs from EHR_SSH_USER@EHR_HOST (custom port etc.):
#EHR_SSH_TARGET=guoyq@10.2.2.34
# Source reference paths (optional): for the AI to read EHR skills docs and source before writing Page Objects/steps.
# Skills docs = <CCSRC_PATH>/skills/ehr-workflow/<module>/; ccsrc is assumed cloned side by side (../ccsrc) by default.
#CCSRC_PATH=../ccsrc
# ehr app source (used by the selector audit npm run check:selectors), defaults to ../ehr; audit is skipped when absent.
#EHR_SRC=../ehr

# Observation mode (off by default): HEADLESS=0 opens a visible browser window (--headed also works);
# SLOW_MO adds a per-action delay in ms to watch step by step, e.g. 500. Empty or 0 = normal speed.
# CI / regression runs must stay headless (unset or =1).
#HEADLESS=0
#SLOW_MO=0
# Keep the browser window open after the run (only when HEADLESS=0) for manual inspection of the final screen.
# Applies to both entry points (npx playwright test and node drive-ml.js); defaults to 30000ms.
#KEEP_BROWSER_MS=30000
