# Copy to .env and adjust per target box. Never commit .env.
# ⚠️ Hosts are separate physical machines; always state which host a run used.
EHR_HOST=fbch34
EHR_USER=demo
EHR_PASS=123
WEBFRAME_DIR=webframe
# 源码参考路径（可选）：AI 写 Page Object/step 前读 EHR 的 skills 文档与源码用。
# skills 文档 = <CCSRC_PATH>/skills/ehr-workflow/<模块>/；默认假定 ccsrc 与本仓库并排克隆（../ccsrc）。
#CCSRC_PATH=../ccsrc
# ehr 应用源码（选择器审计 npm run check:selectors 用），默认 ../ehr，找不到则跳过审计。
#EHR_SRC=../ehr

# 观察模式（默认关）：HEADLESS=0 打开可见浏览器窗口（也可临时用 --headed）；
# SLOW_MO 给每个动作加延迟(ms)，方便逐步看清，如 500。留空或 0 = 正常速度。
# CI / 回归必须保持无头（不设或 =1）。
#HEADLESS=0
#SLOW_MO=0
# 跑完保持浏览器窗口（仅 HEADLESS=0 时生效），供人工检查最终画面。
# 对 npx playwright test 与 node drive-ml.js 两个入口都生效；默认 30000ms。
#KEEP_BROWSER_MS=30000
